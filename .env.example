# Interruptr 环境配置文件
# 复制此文件为 .env 并填入您的API密钥

# ================================
# 大语言模型 API 配置
# ================================

# OpenAI API 配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4000

# Anthropic Claude API 配置  
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TEMPERATURE=0.1
ANTHROPIC_MAX_TOKENS=4000

# Google Gemini API 配置
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=4000

# Ollama 本地推理配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:latest
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=4000

# ================================
# 数据库配置
# ================================

# SQLite 数据库路径
DATABASE_URL=sqlite:///./interruptr.db

# Redis 配置 (可选，用于缓存)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ================================
# API 服务配置
# ================================

# FastAPI 服务配置
API_HOST=localhost
API_PORT=8000
API_DEBUG=true
API_RELOAD=true

# CORS 配置
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# ================================
# Streamlit 前端配置
# ================================

# Streamlit 服务配置
STREAMLIT_HOST=localhost
STREAMLIT_PORT=8501
STREAMLIT_DEBUG=true

# ================================
# 智能体配置
# ================================

# 默认 LLM 提供商 (openai, anthropic, gemini, ollama)
DEFAULT_LLM_PROVIDER=openai

# 智能体角色分配
COORDINATOR_LLM=openai          # 协调者 - GPT-4 (综合协调)
CODE_ANALYST_LLM=claude         # 代码分析师 - Claude (深度分析)
SECURITY_EXPERT_LLM=claude      # 安全专家 - Claude (专业安全)
DEBUG_EXPERT_LLM=openai         # 调试专家 - GPT-4 (调试经验)
ARCHITECT_LLM=claude            # 架构师 - Claude (架构设计)
CRITIC_LLM=gemini              # 质疑者 - Gemini (多角度质疑)
REVIEWER_LLM=ollama            # 检查者 - Ollama本地 (独立验证)

# 智能体最大迭代次数
MAX_AGENT_ITERATIONS=10

# 对话历史保留数量
CONVERSATION_HISTORY_LIMIT=100

# ================================
# 分析工具路径配置
# ================================

# C/C++ 编译和分析工具
GCC_PATH=/usr/bin/gcc
GDB_PATH=/usr/bin/gdb
CLANG_PATH=/usr/bin/clang
VALGRIND_PATH=/usr/bin/valgrind
CPPCHECK_PATH=/usr/bin/cppcheck

# ================================
# 安全检测配置
# ================================

# 安全检测规则严格程度 (low, medium, high)
SECURITY_LEVEL=high

# 最大文件大小 (MB)
MAX_FILE_SIZE=10

# 支持的文件扩展名
SUPPORTED_EXTENSIONS=.c,.cpp,.cc,.cxx,.h,.hpp

# ================================
# 日志配置
# ================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/interruptr.log

# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ================================
# 可视化配置
# ================================

# 自动刷新间隔 (秒)
AUTO_REFRESH_INTERVAL=5

# 图表主题 (plotly, plotly_white, plotly_dark)
CHART_THEME=plotly

# 最大显示消息数
MAX_DISPLAY_MESSAGES=50
